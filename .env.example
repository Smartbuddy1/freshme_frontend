# Optional: Set full backend URL if not proxying via Nginx /api
# If omitted or empty, requests default to /api (standard Nginx reverse proxy)
VITE_API_URL=/api
# Set /freshme/ when deploying at https://aaryainnovtech.com/freshme/.
# Leave / for a dedicated frontend at the domain root.
VITE_BASE_PATH=/
# Vercel server-side setting only; use the actual HTTPS backend base URL.
# BACKEND_URL=https://your-backend.example
# Serve /api through the frontend HTTPS origin to preserve admin session cookies.
# Remote absolute API URLs must use verified HTTPS; never put secrets in VITE_*.
